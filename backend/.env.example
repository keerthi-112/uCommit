# ---------------------------------------------------------------
# uCommit backend configuration
# Copy to .env and fill in. Never commit the real .env.
# ---------------------------------------------------------------

# PostgreSQL connection string.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/uCommit?schema=public"

# Signs and verifies JWTs. Use a long random string; changing it
# invalidates every existing session.
JWT_SECRET="replace-with-a-long-random-secret"

# Port the API listens on. Defaults to 5000.
PORT=5000

# ---------------------------------------------------------------
# Missed day close-out
# ---------------------------------------------------------------
# When true, the server automatically penalises elapsed days that had
# no submission. This MOVES REAL MONEY without anyone pressing a
# button, so it is off unless explicitly enabled.
# Admins can always run it manually via POST /admin/close-days, which
# dry runs unless sent { "apply": true }.
ENABLE_DAY_CLOSE=false

# How often the automatic close-out runs, in hours. The job is
# idempotent, so running it more than once a day is harmless.
DAY_CLOSE_INTERVAL_HOURS=6

# ---------------------------------------------------------------
# AI coach (optional)
# ---------------------------------------------------------------
# Without a key the AI endpoints return a clear "not configured"
# response and the rest of the app is unaffected.
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=
