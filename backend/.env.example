# ---------------------------------------------------------------
# uCommit backend configuration
# Copy to .env and fill in. Never commit the real .env.
# ---------------------------------------------------------------

# PostgreSQL connection string.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/uCommit?schema=public"

# Signs and verifies JWTs. Use a long random string; changing it
# invalidates every existing session.
JWT_SECRET="replace-with-a-long-random-secret"

# Port the API listens on. Defaults to 5000.
# Most hosts set this for you - read it, do not hardcode it.
PORT=5000

# ---------------------------------------------------------------
# Deployment
# ---------------------------------------------------------------
# Which sites may call this API from a browser, comma separated.
# Leave unset locally; ALWAYS set it in production, or any site on the
# internet can call your API with a logged-in user's browser.
#   ALLOWED_ORIGINS=https://ucommit.vercel.app
ALLOWED_ORIGINS=

# Set to true only when running behind a proxy or load balancer, which
# is the case on almost every host. Without it the rate limiter sees
# every request as coming from the proxy and locks all users out
# together. With it set when there is NO proxy, a client can spoof its
# own IP and slip past the limiter.
TRUST_PROXY=false

# NODE_ENV=production also turns the rate limiter on for local
# addresses. Most hosts set this for you.
NODE_ENV=development

# ---------------------------------------------------------------
# Missed day close-out
# ---------------------------------------------------------------
# When true, the server automatically penalises elapsed days that had
# no submission. This MOVES REAL MONEY without anyone pressing a
# button, so it is off unless explicitly enabled.
# Admins can always run it manually via POST /admin/close-days, which
# dry runs unless sent { "apply": true }.
ENABLE_DAY_CLOSE=false

# How often the automatic close-out runs, in hours. The job is
# idempotent, so running it more than once a day is harmless.
DAY_CLOSE_INTERVAL_HOURS=6

# ---------------------------------------------------------------
# AI coach (optional)
# ---------------------------------------------------------------
# Without a key the AI endpoints return a clear "not configured"
# response and the rest of the app is unaffected.
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=
